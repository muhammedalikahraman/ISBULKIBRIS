# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Site Configuration
NEXT_PUBLIC_SITE_URL=https://your-domain.example

# Security
CRON_SECRET=generate-a-long-random-secret

# SEO (optional)
NEXT_PUBLIC_GOOGLE_VERIFICATION=

# Rate limiting
NEXT_PUBLIC_RATE_LIMIT_MAX=100
NEXT_PUBLIC_RATE_LIMIT_WINDOW=60000

# Cloudflare R2 Storage (optional)
NEXT_PUBLIC_CLOUDFLARE_R2_BUCKET=your-bucket
NEXT_PUBLIC_CLOUDFLARE_R2_ACCOUNT_ID=your-account-id
NEXT_PUBLIC_CLOUDFLARE_R2_ACCESS_KEY=your-access-key
NEXT_PUBLIC_CLOUDFLARE_R2_SECRET_KEY=your-secret-key
