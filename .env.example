# Yerel: `npx supabase start` çıktısındaki URL ve anon/service key.
# Bulut: Dashboard > Project Settings > API. Service role'ü sohbete yapıştırma.

NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Bu e-posta ile ilk kayıt olan kullanıcıya admin rolü verilir (product_settings.bootstrap.admin_email).
BOOTSTRAP_ADMIN_EMAIL=
NEXT_PUBLIC_SITE_URL=http://localhost:3000
CRON_SECRET=
